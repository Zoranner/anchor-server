DATABASE_URL=postgres://anchor:anchor@postgres:5432/anchor
DATABASE_MAX_CONNECTIONS=10
ANCHOR_DATA_DIR=/app/data
# 生成主密钥：openssl rand -hex 32 > app/secrets/anchor_master_key
# 主密钥文件只读挂载，不能进入镜像、数据库或日志。
ANCHOR_MASTER_KEY_FILE=/run/secrets/anchor_master_key
ANCHOR_LISTEN_ADDR=0.0.0.0:8080
ANCHOR_PUBLIC_URL=https://anchor.example.com
# 生成初始化令牌：openssl rand -hex 32。首次初始化完成后可从部署环境移除。
ANCHOR_SETUP_TOKEN=
RUST_LOG=info
